# Settings of the production stack (docker-compose.yml). Copy to .env on the
# server and fill in; .env itself never goes into git.

# The site's domain. The admin panel answers on admin.<DOMAIN>; both names
# must already point at the server, or the certificates cannot be issued.
DOMAIN=konkurs.example.ru
# Only if the panel should live on some other name:
#ADMIN_DOMAIN=panel.example.ru

# After the site has moved to a new DOMAIN: the former one keeps answering and
# sends visitors on to the new one (docker-compose.moved.yml). Both lines.
#COMPOSE_FILE=docker-compose.yml:docker-compose.moved.yml
#OLD_DOMAIN=konkurs.old.example.ru

# Let's Encrypt registers the certificates to this address.
ACME_EMAIL=webmaster@example.ru

# The first administrator of the panel. Read once, while the panel has no
# accounts; after signing in change the password there and delete both lines.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=at-least-ten-characters

# Letters to applicants. Without these two the panel sends none.
#SMTP_URL=smtps://login:password@smtp.example.ru:465
#MAIL_FROM="Премия «Знак мастерства» <award@example.ru>"
#MAIL_REPLY_TO=

# How many days the visit log is kept event by event (the totals are kept for
# good). 180 if not set; 0 keeps everything.
#ANALYTICS_KEEP_DAYS=180
